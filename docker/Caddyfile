{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			# Server-Sent Events: stream immediately
			flush_interval -1
		}
	}

	handle {
		root * /srv
		# Hashed assets can be cached forever; index and the service worker must not.
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@nocache path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
