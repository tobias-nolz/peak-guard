# ── Peak Guard configuration ───────────────────────────────────────────────
# Copy to .env and adjust. All values shown are the defaults unless marked required.

# Database (required: password)
POSTGRES_USER=peakguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=peakguard
# Host port for the database (bound to 127.0.0.1 only)
DB_PORT=5432
# TimescaleDB memory/CPU tuning for small hosts
DB_MEMORY=1GB
DB_CPUS=2

# Inverter (required). Real Gen24: http://<inverter-ip>   Mock (dev profile): http://mock-inverter:8080
FRONIUS_URL=http://mock-inverter:8080
# Poll interval in ms (1000–5000 recommended for real hardware)
POLL_INTERVAL_MS=2000
# local = timestamp on receipt (real hardware); inverter = use the API timestamp (accelerated mock)
CLOCK_SOURCE=local
TIME_ZONE=Europe/Vienna
LOG_LEVEL=info

# Images (pre-built from CI, or built locally with `docker compose build`)
IMAGE_PREFIX=ghcr.io/tobias-nolz/peak-guard
IMAGE_TAG=latest

# ── Mock inverter (dev profile only) ──
# Time acceleration: 1 = real time, 30 = one quarter-hour every 30 s.
# With MOCK_SPEED > 1 also set CLOCK_SOURCE=inverter and POLL_INTERVAL_MS ≈ 2000 / MOCK_SPEED (min 100).
MOCK_SPEED=1
# Simulation start (ISO); empty = now
MOCK_START=
MOCK_SEED=42
MOCK_EV_KW=11
MOCK_PV_KWP=10
MOCK_BATTERY_KWH=10.24
MOCK_PORT=8090

# ── Web ──
# Host port of the web UI (Caddy). Put a TLS-terminating reverse proxy in front for HTTPS.
WEB_PORT=8080
