# ── Peak Guard configuration ───────────────────────────────────────────────
# Copy to .env and adjust. All values shown are the defaults unless marked required.

# Database (required: password)
POSTGRES_USER=peakguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=peakguard
# Host port for the database (bound to 127.0.0.1 only)
DB_PORT=5432
# TimescaleDB memory/CPU tuning for small hosts
DB_MEMORY=1GB
DB_CPUS=2

# Inverter (required). Real Gen24: http://<inverter-ip>   Mock (dev profile): http://mock-inverter:8080
FRONIUS_URL=http://mock-inverter:8080
# Poll interval in ms (1000–5000 recommended for real hardware)
POLL_INTERVAL_MS=2000
# local = timestamp on receipt (real hardware); inverter = use the API timestamp (accelerated mock)
CLOCK_SOURCE=local
TIME_ZONE=Europe/Vienna
LOG_LEVEL=info

# Images (pre-built from CI, or built locally with `docker compose build`)
IMAGE_PREFIX=ghcr.io/tobias-nolz/peak-guard
IMAGE_TAG=latest

# ── Mock inverter (dev profile only) ──
# Time acceleration: 1 = real time, 30 = one quarter-hour every 30 s.
# With MOCK_SPEED > 1 also set CLOCK_SOURCE=inverter and POLL_INTERVAL_MS ≈ 2000 / MOCK_SPEED (min 100).
MOCK_SPEED=1
# Simulation start (ISO); empty = now
MOCK_START=
MOCK_SEED=42
MOCK_EV_KW=11
MOCK_PV_KWP=10
MOCK_BATTERY_KWH=10.24
# Mock Modbus TCP (port 1502 inside the container): 'Inverter control via Modbus' switch
# and whether the storage revert timer is honoured (to exercise the revert self-test).
MOCK_MODBUS_CONTROL=true
MOCK_REVERT_SUPPORTED=true
MOCK_PORT=8090

# ── Battery control (phase 2) ──
# Read the battery via Modbus TCP / SunSpec. Enable "Modbus TCP" and "Inverter control
# via Modbus" in the Gen24 web UI first (see docs/hardware.md).
MODBUS_ENABLED=false
# Defaults to the host of FRONIUS_URL. Mock (dev profile): MODBUS_HOST=mock-inverter, MODBUS_PORT=1502
MODBUS_HOST=
MODBUS_PORT=502
MODBUS_UNIT_ID=1
MODBUS_POLL_MS=5000
# KILL SWITCH: nothing is ever written to the inverter unless this is true —
# not in Active mode and not for the revert self-test.
CONTROL_WRITES_ENABLED=false

# ── Notifications (all optional; which events notify is set in Settings) ──
# ntfy: topic URL, e.g. https://ntfy.sh/my-secret-topic (token for protected topics)
NOTIFY_NTFY_URL=
NOTIFY_NTFY_TOKEN=
# Telegram: bot token from @BotFather and your chat id
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=
# Generic webhook: receives a JSON POST {source, ts, kind, title, message, urgent, data}
NOTIFY_WEBHOOK_URL=
# E-mail: smtp(s)://user:password@host:port
NOTIFY_SMTP_URL=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# ── MQTT / Home Assistant (optional) ──
# Own broker: docker compose --profile mqtt up -d  →  MQTT_URL=mqtt://mqtt:1883
# Existing broker (e.g. Home Assistant's Mosquitto add-on): mqtt://user:password@homeassistant.local:1883
MQTT_URL=
MQTT_TOPIC_PREFIX=peakguard
# Home Assistant discovery prefix; empty disables discovery
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_INTERVAL_MS=5000
# Host port of the bundled broker
MQTT_PORT=1883

# ── Authentication ──
# none     = no login (only on a trusted LAN!)
# password = single-user login. Create a hash with:
#            docker compose run --rm api node dist/hash-password.js 'your password'
#            (in .env, escape each $ in the hash as $$)
# proxy    = trust the user header set by an auth proxy (Authelia, Authentik, oauth2-proxy, …).
#            Only safe if Peak Guard is reachable exclusively through that proxy.
AUTH_MODE=none
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
# Plain password instead of a hash (hashed at startup; convenient for testing)
AUTH_PASSWORD=
# 32+ random characters, e.g. `openssl rand -hex 32`; keeps sessions valid across restarts
AUTH_SECRET=
AUTH_SESSION_HOURS=720
AUTH_PROXY_HEADER=Remote-User
# auto = Secure cookie when served via HTTPS (X-Forwarded-Proto: https)
COOKIE_SECURE=auto
# Optional bearer token for Prometheus scraping /api/metrics
METRICS_TOKEN=

# ── Web ──
# Host port of the web UI (Caddy). Put a TLS-terminating reverse proxy in front for HTTPS.
WEB_PORT=8080

# ── Backups (profile "backup": docker compose --profile backup up -d) ──
# Named volume "backups" by default; set a host path to store dumps outside Docker.
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
