# ── Peak Guard configuration ───────────────────────────────────────────────
# Copy to .env and adjust. All values shown are the defaults unless marked required.

# Database (required: password)
POSTGRES_USER=peakguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=peakguard
# Host port for the database (bound to 127.0.0.1 only)
DB_PORT=5432
# TimescaleDB memory/CPU tuning for small hosts
DB_MEMORY=1GB
DB_CPUS=2

# Inverter (required). Real Gen24: http://<inverter-ip>   Mock (dev profile): http://mock-inverter:8080
FRONIUS_URL=http://mock-inverter:8080
# Poll interval in ms (1000–5000 recommended for real hardware)
POLL_INTERVAL_MS=2000
# local = timestamp on receipt (real hardware); inverter = use the API timestamp (accelerated mock)
CLOCK_SOURCE=local
TIME_ZONE=Europe/Vienna
LOG_LEVEL=info

# Images (pre-built from CI, or built locally with `docker compose build`)
IMAGE_PREFIX=ghcr.io/tobias-nolz/peak-guard
IMAGE_TAG=latest

# ── Mock inverter (dev profile only) ──
# Time acceleration: 1 = real time, 30 = one quarter-hour every 30 s.
# With MOCK_SPEED > 1 also set CLOCK_SOURCE=inverter and POLL_INTERVAL_MS ≈ 2000 / MOCK_SPEED (min 100).
MOCK_SPEED=1
# Simulation start (ISO); empty = now
MOCK_START=
MOCK_SEED=42
MOCK_EV_KW=11
MOCK_PV_KWP=10
MOCK_BATTERY_KWH=10.24
MOCK_PORT=8090

# ── Authentication ──
# none     = no login (only on a trusted LAN!)
# password = single-user login. Create a hash with:
#            docker compose run --rm api node dist/hash-password.js 'your password'
#            (in .env, escape each $ in the hash as $$)
# proxy    = trust the user header set by an auth proxy (Authelia, Authentik, oauth2-proxy, …).
#            Only safe if Peak Guard is reachable exclusively through that proxy.
AUTH_MODE=none
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
# Plain password instead of a hash (hashed at startup; convenient for testing)
AUTH_PASSWORD=
# 32+ random characters, e.g. `openssl rand -hex 32`; keeps sessions valid across restarts
AUTH_SECRET=
AUTH_SESSION_HOURS=720
AUTH_PROXY_HEADER=Remote-User
# auto = Secure cookie when served via HTTPS (X-Forwarded-Proto: https)
COOKIE_SECURE=auto
# Optional bearer token for Prometheus scraping /api/metrics
METRICS_TOKEN=

# ── Web ──
# Host port of the web UI (Caddy). Put a TLS-terminating reverse proxy in front for HTTPS.
WEB_PORT=8080
